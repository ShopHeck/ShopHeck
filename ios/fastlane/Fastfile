default_platform(:ios)

# Signing strategy: App Store Connect API key + Xcode automatic ("cloud")
# signing via -allowProvisioningUpdates. No Fastlane Match / certificates repo
# is required — Xcode creates and downloads the distribution certificate and
# App Store provisioning profile on demand, authenticated by the API key below.

APP_IDENTIFIER = "app.fightcamptraining".freeze
TEAM_ID = "WV4L598A44".freeze
# Where we drop the App Store Connect .p8 so xcodebuild can authenticate during
# archive (gitignored; only ever written on the runner / dev machine). Anchored
# to this Fastfile's directory so it resolves regardless of fastlane's cwd.
ASC_KEY_PATH = File.expand_path("AuthKey_asc.p8", __dir__).freeze

# Reject a RevenueCat key that cannot work in a release build.
#
# Emptiness was the only thing checked here before, which let the wrong *kind*
# of key through — and every public RevenueCat key is a valid-looking string,
# so nothing downstream complains either. The failure only appears once a user
# taps Subscribe, as RevenueCat error 11 ("There was a credentials issue")
# rendered by the SDK's own alert over a half-loaded paywall.
#
# Mirrors RevenueCatConfig.validate in ios/App/App/RevenueCatPlugin.swift —
# keep the two in step.
def validate_revenuecat_key!(key)
  if key.empty?
    UI.user_error!("REVENUECAT_API_KEY env var is required for release builds")
  end
  return if key.start_with?("appl_")

  reason =
    if key.start_with?("test_")
      "it is a Test Store key, which only works in debug builds"
    elsif key.start_with?("goog_")
      "it is the Google Play key"
    elsif key.start_with?("amzn_")
      "it is the Amazon key"
    elsif key.start_with?("rcb_") || key.start_with?("strp_")
      "it is a Web Billing key"
    elsif key.start_with?("sk_")
      "it is a secret key, which is server-side only"
    else
      "it does not start with appl_"
    end

  UI.user_error!(<<~MSG)
    REVENUECAT_API_KEY cannot be used for an iOS release build — #{reason}.

    Use the public Apple SDK key: RevenueCat dashboard → Project Settings →
    API keys → "Public app-specific Apple API key". It starts with appl_.

    Shipping the wrong key produces no build error at all; it fails on the
    user's device as "Error 11: There was a credentials issue" when they try
    to subscribe or start a free trial.
  MSG
end

# GitHub Actions defines every key in a step's `env:` block, so a secret that
# does not exist arrives as an empty string rather than being absent. match's
# `git_basic_authorization` defaults to ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
# and in Ruby "" is truthy — so an unset secret still sends
#
#     git clone <url> -c http.extraheader='Authorization: Basic '
#
# an empty credential that OVERRIDES any token embedded in MATCH_GIT_URL. GitHub
# answers "invalid credentials" and match reports it as a repo access problem,
# which sends you looking at permissions that were never wrong.
#
# The whitespace strip matters just as much: `base64` line-wraps at 76 columns,
# so an encoded "x-access-token:<fine-grained PAT>" arrives split across two
# lines. A newline inside the header makes the HTTP request itself malformed and
# GitHub answers 400 — a different error with the same non-obvious cause.
def sanitize_match_env!
  auth = ENV["MATCH_GIT_BASIC_AUTHORIZATION"].to_s.gsub(/\s+/, "")
  if auth.empty?
    ENV.delete("MATCH_GIT_BASIC_AUTHORIZATION")
  else
    ENV["MATCH_GIT_BASIC_AUTHORIZATION"] = auth
  end

  url = ENV["MATCH_GIT_URL"].to_s.strip
  if url.empty?
    ENV.delete("MATCH_GIT_URL")
  else
    ENV["MATCH_GIT_URL"] = url
  end
end

platform :ios do
  before_all do
    sanitize_match_env!

    # match installs the distribution certificate into a keychain, and without
    # this it picks the runner's default `login.keychain`. That keychain is
    # locked on a fresh macOS runner, so when codesign later reaches for the
    # private key during `archive` it blocks on a keychain-access prompt that
    # nothing on a headless CI box can answer — the job hangs until the job
    # timeout rather than failing. `setup_ci` creates a temporary, unlocked
    # keychain and points match at it.
    #
    # This never bit while the pipeline was on automatic signing, because those
    # builds died at provisioning long before any signing key was needed.
    setup_ci if ENV["CI"]

    # Authenticate every lane with the App Store Connect API key. Reads CI
    # secrets. ASC_KEY_CONTENT may be the raw .p8 (PEM) text or base64-encoded —
    # we detect which so either form works.
    key_content = ENV["ASC_KEY_CONTENT"].to_s
    UI.user_error!("ASC_KEY_CONTENT env var is required") if key_content.empty?
    is_base64 = !key_content.include?("PRIVATE KEY")

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key_content,
      is_key_content_base64: is_base64,
      in_house: false
    )

    # fastlane only feeds the API key to the upload step. xcodebuild's automatic
    # signing (-allowProvisioningUpdates) needs the key on disk too, or it falls
    # back to a (non-existent) signed-in Xcode account and the archive fails with
    # "No Accounts" / "No profiles found". Write the .p8 for archive_app to pass.
    require "base64"
    pem = is_base64 ? Base64.decode64(key_content) : key_content
    File.write(ASC_KEY_PATH, pem)
  end

  # Optionally pass a marketing version:  fastlane beta version:1.0.2
  # Omit it to build whatever MARKETING_VERSION is committed in the project.
  desc "Build and upload to TestFlight"
  lane :beta do |options|
    set_marketing_version(options)
    bump_build_number
    archive_app
    upload_to_testflight(
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and submit to the App Store"
  lane :release do
    bump_build_number
    archive_app
    # Metadata, screenshots, and the App Privacy questionnaire are managed in
    # App Store Connect directly, so we skip them here and just attach the build
    # and submit it for review.
    upload_to_app_store(
      app_identifier: APP_IDENTIFIER,
      submit_for_review: true,
      automatic_release: false,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  # Upload the generated App Store screenshots (and previews, on fastlane
  # versions that support them) without touching the build or any other
  # metadata.
  #
  # Generate the assets first — from the repo root:
  #   npm run build
  #   npm run preview &
  #   npm run appstore:assets     # screenshots + previews + size verification
  # then: bundle exec fastlane media
  #
  # `overwrite_screenshots` is required, not optional: without it deliver
  # appends to whatever is already on the version, so the existing wrong-sized
  # images would stay on the listing alongside the new ones.
  #
  # REQUIRES AN EDITABLE VERSION. Screenshots and app previews are version-scoped
  # metadata — once a version is Ready for Sale its media is frozen. If the only
  # version in App Store Connect is the live one, deliver has nothing to write to
  # and fails with "Could not find a version to edit"; the rescue below turns
  # that into instructions.
  desc "Upload App Store screenshots + previews from ios/fastlane/screenshots"
  lane :media do
    screenshots_path = File.expand_path("screenshots", __dir__)
    unless Dir.exist?(File.join(screenshots_path, "en-US"))
      UI.user_error!("No assets at #{screenshots_path}/en-US — run `npm run appstore:assets` from the repo root first")
    end

    begin
      upload_to_app_store(
        app_identifier: APP_IDENTIFIER,
        screenshots_path: screenshots_path,
        # Media only: leave the description, keywords, build, and the App Privacy
        # answers exactly as they are in App Store Connect.
        skip_binary_upload: true,
        skip_metadata: true,
        skip_app_version_update: true,
        submit_for_review: false,
        overwrite_screenshots: true,
        # deliver's own size check duplicates scripts/verify-appstore-assets.mjs;
        # leaving it on gives a second opinion before anything is transmitted.
        run_precheck_before_submit: false,
        force: true
      )
    rescue => e
      raise unless e.message.include?("Could not find a version to edit")

      UI.user_error!(<<~MSG)
        App Store Connect has no editable version to upload screenshots to.

        Screenshots and app previews belong to a specific app version, and a version
        that is already Ready for Sale has its media locked — so there is nothing for
        this lane to write to. Nothing was uploaded and nothing was changed.

        Create the next version first:
          App Store Connect → #{APP_IDENTIFIER} → the "+" beside iOS App in the
          sidebar → enter a version number (e.g. 1.0.1)

        That version opens in "Prepare for Submission", which is editable. Re-run this
        workflow and the screenshots will land on it.

        Note that the new version needs a build attached and has to clear review before
        the screenshots show on the public listing — run the "iOS Build → TestFlight"
        workflow for the build. See docs/app-store-listing.md.
      MSG
    end

    UI.success("Screenshots uploaded.")
    UI.important(
      "App previews: if the videos in screenshots/en-US were not picked up, add them by hand in " \
      "App Store Connect → your version → Previews and Screenshots (drag the .mp4 onto the 6.9\" " \
      "iPhone and 13\" iPad tabs). See docs/app-store-listing.md."
    )
  end

  # --- helpers -------------------------------------------------------------

  # Override CFBundleShortVersionString for this build when `version:` is passed.
  #
  # The build NUMBER is derived from TestFlight automatically (below), but the
  # marketing VERSION is a product decision, so it stays committed in the project
  # and is only overridden on request. Getting it wrong is expensive: Apple
  # rejects the upload only after the archive completes, several minutes in, with
  #
  #   90062  CFBundleShortVersionString [1.0] ... must contain a higher version
  #          than that of the previously approved version [1.0]
  #   90186  Invalid Pre-Release Train. The train version '1.0' is closed for
  #          new build submissions
  #
  # Once a version is approved, its train closes: every later build needs a
  # higher marketing version, and that number must match the version you created
  # in App Store Connect. Note the value lives in project.pbxproj as
  # MARKETING_VERSION — Info.plist only holds the $(MARKETING_VERSION)
  # placeholder, so editing the plist directly does nothing.
  private_lane :set_marketing_version do |options|
    version = options[:version].to_s.strip
    next if version.empty?

    unless version.match?(/\A\d+(\.\d+){1,2}\z/)
      UI.user_error!("version must look like 1.0.2 (got '#{version}')")
    end

    increment_version_number(
      xcodeproj: "App/App.xcodeproj",
      version_number: version
    )
    UI.important("Marketing version set to #{version} for this build (not committed).")
  end

  # Set the build number to one above the highest build already on TestFlight
  # for this app, so every upload is strictly increasing. Falls back to 1 on the
  # very first upload (no existing builds).
  private_lane :bump_build_number do
    latest = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "App/App.xcodeproj",
      build_number: latest + 1
    )
  end

  # Archive an app-store IPA with automatic signing. The production RevenueCat
  # key is injected as a build setting so it lands in Info.plist's
  # RevenueCatAPIKey (AppDelegate crashes on launch if it's empty in Release).
  private_lane :archive_app do
    rc_key = ENV["REVENUECAT_API_KEY"].to_s.strip
    validate_revenuecat_key!(rc_key)

    match_git_url = ENV["MATCH_GIT_URL"].to_s

    if match_git_url.empty?
      # ── Automatic ("cloud") signing ──────────────────────────────────────
      # Xcode mints/downloads the distribution cert + App Store profile on
      # demand via -allowProvisioningUpdates, authenticated by the API key.
      # Simple, but it creates a NEW certificate on each fresh machine, so a
      # busy CI can eventually hit Apple's certificate cap. Set the MATCH_*
      # secrets (see docs/ios-signing.md) to switch to the shared cert below.
      signing_args = [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{ASC_KEY_PATH}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      ].join(" ")

      build_app(
        scheme: "App",
        workspace: "App/App.xcworkspace",
        configuration: "Release",
        export_method: "app-store",
        clean: true,
        output_directory: "./build",
        output_name: "FightCampTraining.ipa",
        xcargs: "#{signing_args} REVENUECAT_API_KEY='#{rc_key}'",
        export_options: {
          signingStyle: "automatic",
          teamID: TEAM_ID
        }
      )
    else
      # ── Shared signing via fastlane match ────────────────────────────────
      # One distribution cert + profile, stored encrypted in MATCH_GIT_URL and
      # reused by every build — no per-run certificate churn. Read-only here;
      # run the `certs` lane once to create/refresh what's in storage.
      match(
        type: "appstore",
        app_identifier: APP_IDENTIFIER,
        git_url: match_git_url,
        readonly: true
      )

      # Flip the Release config to manual signing with the match cert/profile.
      # Without this the archive step still runs Xcode automatic signing, which
      # insists on a per-machine development cert (the exact churn match avoids)
      # and rejects any manually specified distribution identity.
      update_code_signing_settings(
        path: "App/App.xcodeproj",
        targets: ["App"],
        build_configurations: ["Release"],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        bundle_identifier: APP_IDENTIFIER,
        code_sign_identity: "Apple Distribution",
        profile_name: "match AppStore #{APP_IDENTIFIER}"
      )

      build_app(
        scheme: "App",
        workspace: "App/App.xcworkspace",
        configuration: "Release",
        export_method: "app-store",
        clean: true,
        output_directory: "./build",
        output_name: "FightCampTraining.ipa",
        xcargs: "REVENUECAT_API_KEY='#{rc_key}'",
        export_options: {
          signingStyle: "manual",
          teamID: TEAM_ID,
          provisioningProfiles: {
            APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}"
          }
        }
      )
    end
  end

  # Create or refresh the shared signing cert + profile in match storage.
  # Run ONCE after setting the MATCH_* secrets: Actions → iOS Build → Run
  # workflow → lane: certs.
  desc "Bootstrap/refresh the shared match signing certificate"
  lane :certs do
    UI.user_error!("MATCH_GIT_URL must be set to use match") if ENV["MATCH_GIT_URL"].to_s.empty?
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      readonly: false
    )
  end
end
