default_platform(:ios)

# Signing strategy: App Store Connect API key + Xcode automatic ("cloud")
# signing via -allowProvisioningUpdates. No Fastlane Match / certificates repo
# is required — Xcode creates and downloads the distribution certificate and
# App Store provisioning profile on demand, authenticated by the API key below.

APP_IDENTIFIER = "app.fightcamptraining".freeze
TEAM_ID = "WV4L598A44".freeze

# Every bundle in the archive that gets signed on its own.
#
# An embedded extension is a separate bundle with its own App ID, and Xcode
# signs it separately from the app — so it needs its own entry in the Developer
# Portal, its own provisioning profile, and its own code signing settings. None
# of that is inherited from the host app. Adding the TimerLiveActivity widget
# (Live Activities / Dynamic Island) without adding it here failed the archive
# with
#
#   No profiles for 'app.fightcamptraining.timerliveactivity' were found
#
# which arrives after the app target has signed cleanly and so reads like an
# app-level signing fault rather than a missing extension profile.
#
# Add a row here whenever a new extension target is added to the project.
SIGNED_BUNDLES = [
  {
    target: "App",
    identifier: APP_IDENTIFIER,
    name: "FightCamp Training"
  },
  {
    target: "TimerLiveActivity",
    identifier: "#{APP_IDENTIFIER}.timerliveactivity",
    name: "FightCamp Training Timer Live Activity"
  },
  # The watchOS companion. Not an extension but the same signing problem: a
  # separate bundle with its own App ID and its own profile, none of it
  # inherited. The identifier is the host id plus `.watchkitapp` and is not
  # free to change — Apple requires the watch bundle id to be the host id plus
  # a suffix, and a mismatch is rejected at install rather than at build.
  #
  # Its App ID also needs the HealthKit capability; sync_app_capabilities below
  # reads that off the target's entitlements file and enables it.
  {
    target: "FightCampWatch",
    identifier: "#{APP_IDENTIFIER}.watchkitapp",
    name: "FightCamp Training Watch App"
  }
].freeze

SIGNED_IDENTIFIERS = SIGNED_BUNDLES.map { |bundle| bundle[:identifier] }.freeze

# Entitlement key → the App ID capability that has to be enabled on the
# Developer Portal before a profile can carry it.
#
# An entitlement in a target's .entitlements file is only half of the
# arrangement. The other half is a capability on the App ID, and Apple writes an
# App ID's capabilities into a provisioning profile at the moment the profile is
# cut — so a profile issued before a capability was enabled never gains it, no
# matter how many times it is downloaded. Xcode compares the two at archive time
# and stops:
#
#   Provisioning profile "match AppStore app.fightcamptraining.watchkitapp"
#   doesn't include the com.apple.developer.healthkit and
#   com.apple.developer.healthkit.access entitlements.
#
# That arrives ~20 minutes into a macOS run, and names neither of the two things
# that are actually wrong. sync_app_capabilities closes the portal half of the
# gap and sync_match_profiles closes the profile half.
#
# A nil capability means the entitlement needs no capability of its own — Apple
# grants it alongside another one, or Xcode derives it. An entitlement missing
# from this table is an error rather than an assumed nil: guessing reproduces
# exactly the archive failure the table exists to prevent, later and elsewhere.
ENTITLEMENT_CAPABILITIES = {
  "com.apple.developer.associated-domains" => { capability: "ASSOCIATED_DOMAINS" },
  "com.apple.developer.applesignin" => {
    capability: "APPLE_ID_AUTH",
    # Apple refuses Sign in with Apple without a consent setting. "Primary"
    # means this app owns the consent, which is what a first-party app that is
    # not grouped with others wants.
    settings: [{ key: "APPLE_ID_AUTH_APP_CONSENT", options: [{ key: "PRIMARY_APP_CONSENT" }] }]
  },
  "com.apple.developer.healthkit" => { capability: "HEALTHKIT" },
  # Granted by HEALTHKIT rather than being a capability of its own — but it does
  # land in the profile, and Xcode checks the profile for it by name.
  "com.apple.developer.healthkit.access" => { capability: nil },
  "aps-environment" => { capability: "PUSH_NOTIFICATIONS" },
  "com.apple.security.application-groups" => { capability: "APP_GROUPS" },
  # Derived by Xcode from the team prefix. Not a portal capability, and not
  # something the profile has to spell out.
  "keychain-access-groups" => { capability: nil, in_profile: false }
}.freeze

# match names the profiles it stores after the bundle they belong to; both
# update_code_signing_settings and gym's export options have to use the same
# name or the archive signs against a profile that isn't the one installed.
def match_profile_name(identifier)
  "match AppStore #{identifier}"
end

# Where we drop the App Store Connect .p8 so xcodebuild can authenticate during
# archive (gitignored; only ever written on the runner / dev machine). Anchored
# to this Fastfile's directory so it resolves regardless of fastlane's cwd.
ASC_KEY_PATH = File.expand_path("AuthKey_asc.p8", __dir__).freeze

# The Xcode project, for code that opens it directly rather than through an
# action.
#
# fastlane runs a lane's own body from the fastlane/ directory, but wraps each
# *action* it invokes in a further chdir("..") — so the same relative path means
# two different places depending on who reads it. Actions can be handed
# "App/App.xcodeproj" and resolve it against ios/; plain Ruby in a lane body
# resolves it against ios/fastlane/ and fails with
#
#   [Xcodeproj] Unable to open `ios/fastlane/App/App.xcodeproj`
#
# Anchoring to __dir__ removes the distinction.
XCODEPROJ_PATH = File.expand_path("../App/App.xcodeproj", __dir__).freeze

# Reject a RevenueCat key that cannot work in a release build.
#
# Emptiness was the only thing checked here before, which let the wrong *kind*
# of key through — and every public RevenueCat key is a valid-looking string,
# so nothing downstream complains either. The failure only appears once a user
# taps Subscribe, as RevenueCat error 11 ("There was a credentials issue")
# rendered by the SDK's own alert over a half-loaded paywall.
#
# Mirrors RevenueCatConfig.validate in ios/App/App/RevenueCatPlugin.swift —
# keep the two in step.
def validate_revenuecat_key!(key)
  if key.empty?
    UI.user_error!("REVENUECAT_API_KEY env var is required for release builds")
  end
  return if key.start_with?("appl_")

  reason =
    if key.start_with?("test_")
      "it is a Test Store key, which only works in debug builds"
    elsif key.start_with?("goog_")
      "it is the Google Play key"
    elsif key.start_with?("amzn_")
      "it is the Amazon key"
    elsif key.start_with?("rcb_") || key.start_with?("strp_")
      "it is a Web Billing key"
    elsif key.start_with?("sk_")
      "it is a secret key, which is server-side only"
    else
      "it does not start with appl_"
    end

  UI.user_error!(<<~MSG)
    REVENUECAT_API_KEY cannot be used for an iOS release build — #{reason}.

    Use the public Apple SDK key: RevenueCat dashboard → Project Settings →
    API keys → "Public app-specific Apple API key". It starts with appl_.

    Shipping the wrong key produces no build error at all; it fails on the
    user's device as "Error 11: There was a credentials issue" when they try
    to subscribe or start a free trial.
  MSG
end

# GitHub Actions defines every key in a step's `env:` block, so a secret that
# does not exist arrives as an empty string rather than being absent. match's
# `git_basic_authorization` defaults to ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
# and in Ruby "" is truthy — so an unset secret still sends
#
#     git clone <url> -c http.extraheader='Authorization: Basic '
#
# an empty credential that OVERRIDES any token embedded in MATCH_GIT_URL. GitHub
# answers "invalid credentials" and match reports it as a repo access problem,
# which sends you looking at permissions that were never wrong.
#
# The whitespace strip matters just as much: `base64` line-wraps at 76 columns,
# so an encoded "x-access-token:<fine-grained PAT>" arrives split across two
# lines. A newline inside the header makes the HTTP request itself malformed and
# GitHub answers 400 — a different error with the same non-obvious cause.
def sanitize_match_env!
  auth = ENV["MATCH_GIT_BASIC_AUTHORIZATION"].to_s.gsub(/\s+/, "")
  if auth.empty?
    ENV.delete("MATCH_GIT_BASIC_AUTHORIZATION")
  else
    ENV["MATCH_GIT_BASIC_AUTHORIZATION"] = auth
  end

  url = ENV["MATCH_GIT_URL"].to_s.strip
  if url.empty?
    ENV.delete("MATCH_GIT_URL")
  else
    ENV["MATCH_GIT_URL"] = url
  end
end

# The entitlement keys a target actually ships, read out of the project rather
# than restated here. A hand-kept list beside the real one is a second place to
# remember, and forgetting is the exact failure this whole path exists to remove.
def target_entitlement_keys(target_name)
  require "xcodeproj"
  require "plist"

  project = Xcodeproj::Project.open(XCODEPROJ_PATH)
  target = project.targets.find { |candidate| candidate.name == target_name }
  UI.user_error!("No '#{target_name}' target in #{XCODEPROJ_PATH}") if target.nil?

  release = target.build_configurations.find { |config| config.name == "Release" }
  relative = release&.build_settings&.[]("CODE_SIGN_ENTITLEMENTS").to_s
  # A target with no entitlements file signs against any profile for its App ID.
  # TimerLiveActivity is one.
  return [] if relative.empty?

  # CODE_SIGN_ENTITLEMENTS is relative to the directory holding the .xcodeproj.
  path = File.expand_path(relative, File.dirname(XCODEPROJ_PATH))
  unless File.exist?(path)
    UI.user_error!("#{target_name} sets CODE_SIGN_ENTITLEMENTS to #{relative}, which does not exist")
  end

  Plist.parse_xml(path).keys
end

# What ENTITLEMENT_CAPABILITIES says about one entitlement, or a directed error.
def entitlement_rule(key, target_name)
  ENTITLEMENT_CAPABILITIES.fetch(key) do
    UI.user_error!(<<~MSG)
      The #{target_name} target declares the entitlement

        #{key}

      which ENTITLEMENT_CAPABILITIES in ios/fastlane/Fastfile does not know about, so
      this build cannot tell whether its App ID needs a capability enabling first.

      Add a row for it: the App Store Connect capability type it requires (the names
      are in Spaceship::ConnectAPI::BundleIdCapability::Type), or `capability: nil`
      if Apple grants it without one. Currently known:

      #{ENTITLEMENT_CAPABILITIES.keys.map { |known| "  #{known}" }.join("\n")}

      Stopping here rather than archiving: an entitlement whose capability is off is
      not a build error, it is a signing error twenty minutes from now.
    MSG
  end
end

# The capabilities a target's App ID has to have enabled, with the settings
# Apple requires to enable each one.
def required_capabilities(target_name)
  target_entitlement_keys(target_name).filter_map do |key|
    rule = entitlement_rule(key, target_name)
    next if rule[:capability].nil?

    { type: rule[:capability], settings: rule.fetch(:settings, []) }
  end.uniq { |capability| capability[:type] }
end

# The entitlements that have to appear in the profile a target signs against.
def profile_entitlement_keys(target_name)
  target_entitlement_keys(target_name).select do |key|
    entitlement_rule(key, target_name).fetch(:in_profile, true)
  end
end

# Where match leaves the profile it installed for a bundle. match publishes one
# of these per app identifier it processes — it is how it hands the profile to
# xcodebuild, so it is a stable interface rather than an internal detail.
def match_profile_path_env_key(identifier)
  "sigh_#{identifier}_appstore_profile-path"
end

# Signed identifiers whose installed profile is missing an entitlement that its
# target ships — the archive failure, found in a second instead of twenty
# minutes, and found however the profile went stale. Enabling a capability by
# hand in the Developer Portal leaves every already-issued profile behind
# without touching this repo at all, and looks identical from here.
def stale_profile_identifiers
  require "fastlane_core"

  SIGNED_BUNDLES.filter_map do |bundle|
    wanted = profile_entitlement_keys(bundle[:target])
    next if wanted.empty?

    path = ENV[match_profile_path_env_key(bundle[:identifier])].to_s
    if path.empty? || !File.exist?(path)
      UI.important("No installed profile for #{bundle[:identifier]} to check entitlements against.")
      next
    end

    carried = FastlaneCore::ProvisioningProfile.parse(path)["Entitlements"] || {}
    missing = wanted.reject { |key| carried.key?(key) }
    next if missing.empty?

    UI.important("#{match_profile_name(bundle[:identifier])} does not carry #{missing.join(', ')}.")
    bundle[:identifier]
  end
end

platform :ios do
  before_all do
    sanitize_match_env!

    # match installs the distribution certificate into a keychain, and without
    # this it picks the runner's default `login.keychain`. That keychain is
    # locked on a fresh macOS runner, so when codesign later reaches for the
    # private key during `archive` it blocks on a keychain-access prompt that
    # nothing on a headless CI box can answer — the job hangs until the job
    # timeout rather than failing. `setup_ci` creates a temporary, unlocked
    # keychain and points match at it.
    #
    # This never bit while the pipeline was on automatic signing, because those
    # builds died at provisioning long before any signing key was needed.
    setup_ci if ENV["CI"]

    # Authenticate every lane with the App Store Connect API key. Reads CI
    # secrets. ASC_KEY_CONTENT may be the raw .p8 (PEM) text or base64-encoded —
    # we detect which so either form works.
    key_content = ENV["ASC_KEY_CONTENT"].to_s
    UI.user_error!("ASC_KEY_CONTENT env var is required") if key_content.empty?
    is_base64 = !key_content.include?("PRIVATE KEY")

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key_content,
      is_key_content_base64: is_base64,
      in_house: false
    )

    # fastlane only feeds the API key to the upload step. xcodebuild's automatic
    # signing (-allowProvisioningUpdates) needs the key on disk too, or it falls
    # back to a (non-existent) signed-in Xcode account and the archive fails with
    # "No Accounts" / "No profiles found". Write the .p8 for archive_app to pass.
    require "base64"
    pem = is_base64 ? Base64.decode64(key_content) : key_content
    File.write(ASC_KEY_PATH, pem)
  end

  # Optionally pass a marketing version:  fastlane beta version:1.0.2
  # Omit it to build whatever MARKETING_VERSION is committed in the project.
  desc "Build and upload to TestFlight"
  lane :beta do |options|
    set_marketing_version(options)
    bump_build_number
    archive_app
    upload_to_testflight(
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and submit to the App Store"
  lane :release do
    bump_build_number
    archive_app
    # Metadata, screenshots, and the App Privacy questionnaire are managed in
    # App Store Connect directly, so we skip them here and just attach the build
    # and submit it for review.
    upload_to_app_store(
      app_identifier: APP_IDENTIFIER,
      submit_for_review: true,
      automatic_release: false,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  # Upload the generated App Store screenshots (and previews, on fastlane
  # versions that support them) without touching the build or any other
  # metadata.
  #
  # Generate the assets first — from the repo root:
  #   npm run build
  #   npm run preview &
  #   npm run appstore:assets     # screenshots + previews + size verification
  # then: bundle exec fastlane media
  #
  # `overwrite_screenshots` is required, not optional: without it deliver
  # appends to whatever is already on the version, so the existing wrong-sized
  # images would stay on the listing alongside the new ones.
  #
  # REQUIRES AN EDITABLE VERSION. Screenshots and app previews are version-scoped
  # metadata — once a version is Ready for Sale its media is frozen. If the only
  # version in App Store Connect is the live one, deliver has nothing to write to
  # and fails with "Could not find a version to edit"; the rescue below turns
  # that into instructions.
  desc "Upload App Store screenshots + previews from ios/fastlane/screenshots"
  lane :media do
    screenshots_path = File.expand_path("screenshots", __dir__)
    unless Dir.exist?(File.join(screenshots_path, "en-US"))
      UI.user_error!("No assets at #{screenshots_path}/en-US — run `npm run appstore:assets` from the repo root first")
    end

    begin
      upload_to_app_store(
        app_identifier: APP_IDENTIFIER,
        screenshots_path: screenshots_path,
        # Media only: leave the description, keywords, build, and the App Privacy
        # answers exactly as they are in App Store Connect.
        skip_binary_upload: true,
        skip_metadata: true,
        skip_app_version_update: true,
        submit_for_review: false,
        overwrite_screenshots: true,
        # Replace leftover app previews on every display size (old UI videos
        # otherwise stay on the 6.5" tab forever because 6.9" uploads never
        # touch that slot).
        overwrite_preview_videos: true,
        # deliver's own size check duplicates scripts/verify-appstore-assets.mjs;
        # leaving it on gives a second opinion before anything is transmitted.
        run_precheck_before_submit: false,
        force: true
      )
    rescue => e
      raise unless e.message.include?("Could not find a version to edit")

      UI.user_error!(<<~MSG)
        App Store Connect has no editable version to upload screenshots to.

        Screenshots and app previews belong to a specific app version, and a version
        that is already Ready for Sale has its media locked — so there is nothing for
        this lane to write to. Nothing was uploaded and nothing was changed.

        Create the next version first:
          App Store Connect → #{APP_IDENTIFIER} → the "+" beside iOS App in the
          sidebar → enter a version number (e.g. 1.0.1)

        That version opens in "Prepare for Submission", which is editable. Re-run this
        workflow and the screenshots will land on it.

        Note that the new version needs a build attached and has to clear review before
        the screenshots show on the public listing — run the "iOS Build → TestFlight"
        workflow for the build. See docs/app-store-listing.md.
      MSG
    end

    UI.success("Screenshots uploaded.")
    UI.important(
      "App previews: if the videos in screenshots/en-US were not picked up, add them by hand in " \
      "App Store Connect → your version → Previews and Screenshots (drag the .mp4 onto the 6.9\" " \
      "iPhone and 13\" iPad tabs). See docs/app-store-listing.md."
    )
  end

  # --- helpers -------------------------------------------------------------

  # Override CFBundleShortVersionString for this build when `version:` is passed.
  #
  # The build NUMBER is derived from TestFlight automatically (below), but the
  # marketing VERSION is a product decision, so it stays committed in the project
  # and is only overridden on request. Getting it wrong is expensive: Apple
  # rejects the upload only after the archive completes, several minutes in, with
  #
  #   90062  CFBundleShortVersionString [1.0] ... must contain a higher version
  #          than that of the previously approved version [1.0]
  #   90186  Invalid Pre-Release Train. The train version '1.0' is closed for
  #          new build submissions
  #
  # Once a version is approved, its train closes: every later build needs a
  # higher marketing version, and that number must match the version you created
  # in App Store Connect. Note the value lives in project.pbxproj as
  # MARKETING_VERSION — Info.plist only holds the $(MARKETING_VERSION)
  # placeholder, so editing the plist directly does nothing.
  private_lane :set_marketing_version do |options|
    version = options[:version].to_s.strip
    next if version.empty?

    unless version.match?(/\A\d+(\.\d+){1,2}\z/)
      UI.user_error!("version must look like 1.0.2 (got '#{version}')")
    end

    increment_version_number(
      xcodeproj: "App/App.xcodeproj",
      version_number: version
    )
    UI.important("Marketing version set to #{version} for this build (not committed).")
  end

  # Set the build number to one above the highest build already on TestFlight
  # for this app, so every upload is strictly increasing. Falls back to 1 on the
  # very first upload (no existing builds).
  private_lane :bump_build_number do
    latest = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "App/App.xcodeproj",
      build_number: latest + 1
    )
  end

  # Copy the app's two version numbers onto every other target in the project.
  #
  # Apple rejects an upload whose extension does not carry exactly the same
  # CFBundleVersion and CFBundleShortVersionString as the app that contains it:
  #
  #   90057  The CFBundleVersion value '2' of extension
  #          App.app/PlugIns/TimerLiveActivity.appex does not match the
  #          CFBundleVersion value '13' of its containing iOS application
  #
  # and the bump above cannot prevent that on its own. increment_build_number
  # shells out to `agvtool new-version -all`, and despite the name `-all` only
  # reaches targets whose VERSIONING_SYSTEM is apple-generic. The App target's
  # is; the extension's is not, so the extension keeps whatever build number was
  # committed and falls further behind on every release.
  #
  # Setting VERSIONING_SYSTEM on the extension would work too, but it leaves the
  # guarantee resting on a build setting nobody looks at, in a file that is
  # mostly machine-generated. Reading back what the app actually ended up with
  # and writing it everywhere is the same result without the tripwire — and it
  # covers the marketing version, which has the identical failure mode.
  private_lane :sync_extension_versions do
    require "xcodeproj"

    project = Xcodeproj::Project.open(XCODEPROJ_PATH)

    app_target = project.targets.find { |target| target.name == "App" }
    UI.user_error!("No 'App' target in #{XCODEPROJ_PATH}") if app_target.nil?

    app_release = app_target.build_configurations.find { |config| config.name == "Release" }
    build_version = app_release.build_settings["CURRENT_PROJECT_VERSION"]
    marketing_version = app_release.build_settings["MARKETING_VERSION"]

    other_targets = project.targets.reject { |target| target == app_target }
    other_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings["CURRENT_PROJECT_VERSION"] = build_version
        config.build_settings["MARKETING_VERSION"] = marketing_version
      end
      UI.message("#{target.name} pinned to #{marketing_version} (#{build_version}) to match the app.")
    end

    project.save
  end

  # Archive an app-store IPA with automatic signing. The production RevenueCat
  # key is injected as a build setting so it lands in Info.plist's
  # RevenueCatAPIKey (AppDelegate crashes on launch if it's empty in Release).
  private_lane :archive_app do
    rc_key = ENV["REVENUECAT_API_KEY"].to_s.strip
    validate_revenuecat_key!(rc_key)

    sync_extension_versions

    match_git_url = ENV["MATCH_GIT_URL"].to_s

    if match_git_url.empty?
      # ── Automatic ("cloud") signing ──────────────────────────────────────
      # Xcode mints/downloads the distribution cert + App Store profile on
      # demand via -allowProvisioningUpdates, authenticated by the API key.
      # Simple, but it creates a NEW certificate on each fresh machine, so a
      # busy CI can eventually hit Apple's certificate cap. Set the MATCH_*
      # secrets (see docs/ios-signing.md) to switch to the shared cert below.
      #
      # The App IDs still need their capabilities set: whether a profile is cut
      # by Xcode or by match, Apple only puts into it what the App ID has
      # enabled at that moment.
      sync_app_capabilities

      signing_args = [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{ASC_KEY_PATH}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      ].join(" ")

      build_app(
        scheme: "App",
        workspace: "App/App.xcworkspace",
        configuration: "Release",
        export_method: "app-store",
        clean: true,
        output_directory: "./build",
        output_name: "FightCampTraining.ipa",
        xcargs: "#{signing_args} REVENUECAT_API_KEY='#{rc_key}'",
        export_options: {
          signingStyle: "automatic",
          teamID: TEAM_ID
        }
      )
    else
      # ── Shared signing via fastlane match ────────────────────────────────
      # One distribution cert + a profile per signed bundle, stored encrypted in
      # MATCH_GIT_URL and reused by every build — no per-run certificate churn.
      sync_match_profiles(git_url: match_git_url)

      # Flip the Release config to manual signing with the match cert/profile.
      # Without this the archive step still runs Xcode automatic signing, which
      # insists on a per-machine development cert (the exact churn match avoids)
      # and rejects any manually specified distribution identity.
      #
      # One call per target: the action takes a single bundle_identifier and
      # profile_name, and each bundle has its own.
      SIGNED_BUNDLES.each do |bundle|
        update_code_signing_settings(
          path: "App/App.xcodeproj",
          targets: [bundle[:target]],
          build_configurations: ["Release"],
          use_automatic_signing: false,
          team_id: TEAM_ID,
          bundle_identifier: bundle[:identifier],
          code_sign_identity: "Apple Distribution",
          profile_name: match_profile_name(bundle[:identifier])
        )
      end

      export_profiles = SIGNED_IDENTIFIERS.each_with_object({}) do |identifier, mapping|
        mapping[identifier] = match_profile_name(identifier)
      end

      build_app(
        scheme: "App",
        workspace: "App/App.xcworkspace",
        configuration: "Release",
        export_method: "app-store",
        clean: true,
        output_directory: "./build",
        output_name: "FightCampTraining.ipa",
        xcargs: "REVENUECAT_API_KEY='#{rc_key}'",
        export_options: {
          signingStyle: "manual",
          teamID: TEAM_ID,
          # Export needs a profile for the extension too, or the re-sign step
          # after a successful archive fails with "no profile for ...".
          provisioningProfiles: export_profiles
        }
      )
    end
  end

  # Install the shared cert plus one App Store profile per signed bundle.
  #
  # readonly is the right default for a build lane: it cannot mint a
  # certificate, so no amount of CI churn can walk the account into Apple's
  # certificate cap. But readonly also cannot create a profile that was never
  # stored — and that is exactly the state the certs repo is in the first time
  # a new embedded bundle appears in the project. The TimerLiveActivity
  # extension put it there, and every build failed until the profile existed.
  #
  # So: try readonly, and if the only thing missing is a profile, generate the
  # missing ones and push them to the certs repo (which the documented deploy
  # key already has write access to for the `certs` lane). This never creates a
  # certificate — match reuses whatever is in storage — so the property that
  # made readonly worth having is preserved. Any other match failure, an
  # expired or absent certificate above all, still stops the build: silently
  # re-issuing one is how the cap gets hit.
  private_lane :sync_match_profiles do |options|
    git_url = options[:git_url]

    # The Developer Portal comes first. A profile records its App ID's
    # capabilities as they stood when it was cut, so a capability enabled
    # afterwards reaches nothing that already exists — doing this before any
    # profile is fetched or created is what keeps the re-issue below rare.
    sync_app_capabilities

    begin
      match(
        type: "appstore",
        app_identifier: SIGNED_IDENTIFIERS,
        git_url: git_url,
        readonly: true
      )
    rescue => e
      raise unless e.message.match?(/provisioning profile/i)

      UI.important(
        "match has no stored App Store profile for one of #{SIGNED_IDENTIFIERS.join(', ')} — " \
        "generating the missing profile(s) and pushing them to the certs repo. " \
        "The shared signing certificate is reused, not reissued."
      )

      match(
        type: "appstore",
        app_identifier: SIGNED_IDENTIFIERS,
        git_url: git_url,
        readonly: false
      )
    end

    # Every profile is on disk now, so they can be read rather than assumed.
    renew_stale_profiles(git_url: git_url)
  end

  # Re-issue any installed profile that does not carry the entitlements its
  # target ships, then prove the result.
  #
  # match repairs some of this itself, but only when it is not read-only: with a
  # spaceship session it asks the portal whether each stored profile is still
  # valid, and enabling a capability invalidates that App ID's profiles, so a
  # `readonly: false` run deletes and regenerates them. Every archive runs
  # read-only, which skips that check entirely — and the check that does run is
  # about Apple's *status* for a profile, not about whether the profile matches
  # the entitlements a target actually ships. Reading the profile settles both
  # without depending on Apple having invalidated anything.
  #
  # Re-issuing is profile-only; match reuses the stored certificate, so this
  # cannot walk the account towards Apple's certificate cap.
  private_lane :renew_stale_profiles do |options|
    stale = stale_profile_identifiers
    next if stale.empty?

    UI.important(
      "Re-issuing the App Store profile for #{stale.join(', ')}: the stored one predates " \
      "a capability its target now needs. The shared certificate is reused, not reissued."
    )

    match(
      type: "appstore",
      app_identifier: stale,
      git_url: options[:git_url],
      readonly: false,
      force: true
    )

    still_stale = stale_profile_identifiers
    next if still_stale.empty?

    UI.user_error!(<<~MSG)
      Re-cut the App Store profile for #{still_stale.join(', ')} and it still does not
      carry the entitlements that target ships.

      Apple writes an App ID's *enabled* capabilities into a profile as it is issued,
      so a brand-new profile that is still missing one means the capability is not
      actually on the App ID. Check it directly:

        Developer Portal → Certificates, Identifiers & Profiles → Identifiers →
        the identifier above

      A few capabilities cannot be turned on through the App Store Connect API and
      have to be ticked there once by hand. Do that, then re-run: the profile is
      re-cut automatically on the next run.

      Failing here rather than letting this pass as a success: the next archive would
      fail ~20 minutes in with "doesn't include the ... entitlement" — the same fact,
      reported later and without naming the App ID as the thing to fix.
    MSG
  end

  # Make sure every signed App ID exists and has the capabilities its target's
  # entitlements require.
  #
  # An App ID is not implied by a bundle identifier and its capabilities are not
  # implied by an entitlements file; both are account state, and both have to be
  # put there. Doing it from the entitlements the targets actually ship means
  # adding an entitlement is one edit rather than an edit plus a visit to the
  # portal that nothing reminds you to make.
  private_lane :sync_app_capabilities do
    SIGNED_BUNDLES.each do |bundle|
      app_id = register_app_identifier(identifier: bundle[:identifier], name: bundle[:name])

      wanted = required_capabilities(bundle[:target])
      next if wanted.empty?

      enabled = app_id.get_capabilities
      wanted.each do |capability|
        next if enabled.any? { |existing| existing.is_type?(capability[:type]) }

        UI.important("Enabling #{capability[:type]} on #{bundle[:identifier]} — its entitlements need it.")
        app_id.create_capability(capability[:type], settings: capability[:settings])
      end
    end
  end

  # Register a bundle ID on the Developer Portal, if it isn't already.
  #
  # A profile can only be cut for an App ID that already exists, and match does
  # not create one — it fails inside sigh with "Could not find App with App
  # Identifier", which names neither the extension nor the fix.
  #
  # This talks to App Store Connect directly rather than through the `produce`
  # action: produce still authenticates with `Spaceship.login(username, ...)`,
  # an Apple ID and password, and this pipeline has only the App Store Connect
  # API key. `Spaceship::ConnectAPI.token` is already set by the
  # app_store_connect_api_key call in before_all, so these two calls are
  # authenticated by the same key everything else uses.
  #
  # An extension gets a Developer Portal identifier only — it is not a separate
  # App Store listing, so nothing is created on the store side.
  #
  # Returns the App ID either way, so the caller can go on to read or set its
  # capabilities without looking it up a second time.
  private_lane :register_app_identifier do |options|
    require "spaceship"

    identifier = options[:identifier]
    existing = Spaceship::ConnectAPI::BundleId.find(identifier)
    if existing
      UI.message("App ID #{identifier} already registered.")
      next existing
    end

    UI.important("Registering App ID #{identifier} on the Developer Portal.")
    Spaceship::ConnectAPI::BundleId.create(
      name: options[:name],
      identifier: identifier,
      platform: Spaceship::ConnectAPI::Platform::IOS,
      seed_id: TEAM_ID
    )
  end

  # Create or refresh the shared signing cert + profiles in match storage.
  # Run ONCE after setting the MATCH_* secrets: Actions → iOS Build → Run
  # workflow → lane: certs.
  desc "Bootstrap/refresh the shared match signing certificate"
  lane :certs do
    UI.user_error!("MATCH_GIT_URL must be set to use match") if ENV["MATCH_GIT_URL"].to_s.empty?

    sync_app_capabilities

    match(
      type: "appstore",
      app_identifier: SIGNED_IDENTIFIERS,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      readonly: false
    )

    # This lane advertises itself as a refresh, so it has to leave storage in a
    # state the next archive can sign against. The match call above repairs a
    # profile the portal reports as invalid, which is what a capability enabled a
    # moment ago normally produces — but "Apple invalidated it" and "it carries
    # the entitlements this target ships" are not the same claim, and only the
    # second one is what the archive checks.
    renew_stale_profiles(git_url: ENV.fetch("MATCH_GIT_URL"))
  end
end
