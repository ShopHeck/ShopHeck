default_platform(:ios)

# Signing strategy: App Store Connect API key + Xcode automatic ("cloud")
# signing via -allowProvisioningUpdates. No Fastlane Match / certificates repo
# is required — Xcode creates and downloads the distribution certificate and
# App Store provisioning profile on demand, authenticated by the API key below.

APP_IDENTIFIER = "app.fightcamptraining".freeze
TEAM_ID = "WV4L598A44".freeze
# Where we drop the App Store Connect .p8 so xcodebuild can authenticate during
# archive (gitignored; only ever written on the runner / dev machine). Anchored
# to this Fastfile's directory so it resolves regardless of fastlane's cwd.
ASC_KEY_PATH = File.expand_path("AuthKey_asc.p8", __dir__).freeze

platform :ios do
  before_all do
    # Authenticate every lane with the App Store Connect API key. Reads CI
    # secrets. ASC_KEY_CONTENT may be the raw .p8 (PEM) text or base64-encoded —
    # we detect which so either form works.
    key_content = ENV["ASC_KEY_CONTENT"].to_s
    UI.user_error!("ASC_KEY_CONTENT env var is required") if key_content.empty?
    is_base64 = !key_content.include?("PRIVATE KEY")

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key_content,
      is_key_content_base64: is_base64,
      in_house: false
    )

    # fastlane only feeds the API key to the upload step. xcodebuild's automatic
    # signing (-allowProvisioningUpdates) needs the key on disk too, or it falls
    # back to a (non-existent) signed-in Xcode account and the archive fails with
    # "No Accounts" / "No profiles found". Write the .p8 for archive_app to pass.
    require "base64"
    pem = is_base64 ? Base64.decode64(key_content) : key_content
    File.write(ASC_KEY_PATH, pem)
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    bump_build_number
    archive_app
    upload_to_testflight(
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and submit to the App Store"
  lane :release do
    bump_build_number
    archive_app
    # Metadata, screenshots, and the App Privacy questionnaire are managed in
    # App Store Connect directly, so we skip them here and just attach the build
    # and submit it for review.
    upload_to_app_store(
      app_identifier: APP_IDENTIFIER,
      submit_for_review: true,
      automatic_release: false,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  # --- helpers -------------------------------------------------------------

  # Set the build number to one above the highest build already on TestFlight
  # for this app, so every upload is strictly increasing. Falls back to 1 on the
  # very first upload (no existing builds).
  private_lane :bump_build_number do
    latest = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "App/App.xcodeproj",
      build_number: latest + 1
    )
  end

  # Archive an app-store IPA with automatic signing. The production RevenueCat
  # key is injected as a build setting so it lands in Info.plist's
  # RevenueCatAPIKey (AppDelegate crashes on launch if it's empty in Release).
  private_lane :archive_app do
    rc_key = ENV["REVENUECAT_API_KEY"].to_s
    UI.user_error!("REVENUECAT_API_KEY env var is required for release builds") if rc_key.empty?

    match_git_url = ENV["MATCH_GIT_URL"].to_s

    if match_git_url.empty?
      # ── Automatic ("cloud") signing ──────────────────────────────────────
      # Xcode mints/downloads the distribution cert + App Store profile on
      # demand via -allowProvisioningUpdates, authenticated by the API key.
      # Simple, but it creates a NEW certificate on each fresh machine, so a
      # busy CI can eventually hit Apple's certificate cap. Set the MATCH_*
      # secrets (see docs/ios-signing.md) to switch to the shared cert below.
      signing_args = [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{ASC_KEY_PATH}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      ].join(" ")

      build_app(
        scheme: "App",
        workspace: "App/App.xcworkspace",
        configuration: "Release",
        export_method: "app-store",
        clean: true,
        output_directory: "./build",
        output_name: "FightCampTraining.ipa",
        xcargs: "#{signing_args} REVENUECAT_API_KEY='#{rc_key}'",
        export_options: {
          signingStyle: "automatic",
          teamID: TEAM_ID
        }
      )
    else
      # ── Shared signing via fastlane match ────────────────────────────────
      # One distribution cert + profile, stored encrypted in MATCH_GIT_URL and
      # reused by every build — no per-run certificate churn. Read-only here;
      # run the `certs` lane once to create/refresh what's in storage.
      match(
        type: "appstore",
        app_identifier: APP_IDENTIFIER,
        git_url: match_git_url,
        readonly: true
      )

      build_app(
        scheme: "App",
        workspace: "App/App.xcworkspace",
        configuration: "Release",
        export_method: "app-store",
        clean: true,
        output_directory: "./build",
        output_name: "FightCampTraining.ipa",
        xcargs: "REVENUECAT_API_KEY='#{rc_key}'",
        export_options: {
          signingStyle: "manual",
          teamID: TEAM_ID,
          provisioningProfiles: {
            APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}"
          }
        }
      )
    end
  end

  # Create or refresh the shared signing cert + profile in match storage.
  # Run ONCE after setting the MATCH_* secrets: Actions → iOS Build → Run
  # workflow → lane: certs.
  desc "Bootstrap/refresh the shared match signing certificate"
  lane :certs do
    UI.user_error!("MATCH_GIT_URL must be set to use match") if ENV["MATCH_GIT_URL"].to_s.empty?
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      readonly: false
    )
  end
end
