// Template for production secrets.
//
// Setup:
//   1. Copy this file to Secrets.xcconfig in the same directory.
//   2. Replace the placeholder below with your real RevenueCat
//      public Apple SDK key (RevenueCat dashboard → Project Settings →
//      API keys → "Public app-specific Apple API key"). It starts with `appl_`.
//   3. Secrets.xcconfig is gitignored — never commit it.
//   4. Archive in Xcode. The key is substituted into Info.plist's
//      RevenueCatAPIKey at build time.

REVENUECAT_API_KEY = appl_REPLACE_WITH_YOUR_PRODUCTION_KEY
