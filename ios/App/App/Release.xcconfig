// Release build configuration.
//
// Layer order matters:
//   1. CocoaPods' generated xcconfig — preserves all Pods build settings.
//   2. Secrets.xcconfig (optional, gitignored) — provides REVENUECAT_API_KEY
//      and any future production secrets. Use #include? so missing-file does
//      not break the build; AppDelegate will still crash-on-launch if the key
//      ends up empty in a Release build, which is the intended fail-fast.

#include "../Pods/Target Support Files/Pods-App/Pods-App.release.xcconfig"
#include? "Secrets.xcconfig"

// Sign in with Apple capability (native iOS). Path is relative to the project
// dir (ios/App). The App ID must also have "Sign In with Apple" enabled in the
// Apple Developer portal, or automatic signing can't build a matching profile.
CODE_SIGN_ENTITLEMENTS = App/App.entitlements
