<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Fight Camp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both are inherited from the build settings, which the Fastlane
	     sync_extension_versions lane keeps equal to the host app's. A watch
	     bundle whose version differs from its host is rejected at upload. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Which iPhone app this watch app belongs to. Must be the host bundle
	     id exactly; a mismatch is not a build error, it is a watch app that
	     silently never installs. -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>app.fightcamptraining</string>
	<!-- Single-target watch app (watchOS 7+ layout) rather than the legacy
	     WatchKit app + extension pair. -->
	<key>WKApplication</key>
	<true/>
	<!-- The timer has to keep counting, and the heart-rate stream has to keep
	     sampling, while the fighter's wrist is down mid-round. Workout
	     processing is the mode that grants both. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>

	<!-- Both strings are required, and the second one is not optional however
	     read-only the code is. Apple's check is on the ENTITLEMENT, not on what
	     the bundle actually calls: any bundle carrying com.apple.developer.healthkit
	     must ship both, and the upload is rejected without them —

	       Missing purpose string in Info.plist ... The Info.plist file for the
	       "App.app/Watch/FightCampWatch.app" bundle should contain a
	       NSHealthUpdateUsageDescription key (90683)

	     which lands after a green ~20-minute archive, at upload. This file
	     previously carried only the share string, on the reasoning that
	     WorkoutHeartRate requests `toShare: []` and so should not ask for a
	     permission it never uses. True of the code, but not the rule the
	     validator applies; the error text says as much ("While your app might
	     not use these APIs, a purpose string is still required").

	     The write string is honest about the fact that this bundle does not
	     write: an HKWorkoutSession is capable of saving a workout, and the
	     wording says who actually does it rather than claiming a behaviour the
	     watch does not have. WorkoutHeartRate still calls discardWorkout() and
	     the phone app owns writing to Health. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Fight Camp reads your heart rate during a round session to show live training zones.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Fight Camp does not save workouts from your watch — your iPhone writes completed sessions to Apple Health when you log them.</string>
</dict>
</plist>
