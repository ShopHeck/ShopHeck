{
  "name": "shopheck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:security": "node scripts/security-regression.mjs",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "quality": "npm run lint && npm run test && npm run test:security && npm run typecheck:functions && npm run build",
    "preview": "vite preview",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:iap": "node scripts/iap-screenshots.mjs",
    "preview:video": "node scripts/app-preview.mjs",
    "verify:appstore": "node scripts/verify-appstore-assets.mjs",
    "appstore:assets": "npm run screenshots && npm run preview:video && npm run verify:appstore",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/bluetooth-le": "^7.3.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@sentry/capacitor": "^4.0.0",
    "@sentry/react": "10.43.0",
    "@supabase/supabase-js": "^2.106.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "stripe": "^22.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "^9.39.1",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.62.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.7"
  }
}
