# Stripe Payment Link URLs (web only — iOS uses Apple IAP via RevenueCat)
# These are already configured payment pages. The production URLs remain as
# code fallbacks; set these only when overriding them for staging or rotation.
VITE_STRIPE_FIGHTER_PRO_MONTHLY=
VITE_STRIPE_FIGHTER_PRO_ANNUAL=
VITE_STRIPE_COACH_PRO_MONTHLY=
VITE_STRIPE_COACH_PRO_ANNUAL=

# Comp / founder access — comma-separated emails that get free lifetime Coach Pro
# when signed in (internal testing). The owner email is always included in code;
# use this to grant additional testers without a code change.
VITE_COMP_PRO_EMAILS=

# Google AdSense
# Get these from adsense.google.com after approval
VITE_ADSENSE_CLIENT=ca-pub-
VITE_ADSENSE_SLOT_BANNER=

# Sentry — crash reporting and error monitoring
# Create a Capacitor project at sentry.io to get your DSN
VITE_SENTRY_DSN=

# Supabase — cloud accounts, data sync, auth providers
# Get these from your Supabase project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL for the Netlify functions when the app is NOT served from the site
# itself (the native iOS build runs from capacitor://localhost). Defaults to the
# production site; override for a staging environment.
# VITE_FUNCTIONS_BASE=https://fightcamp.netlify.app

# ─── Server-side only (set in Netlify → Environment variables, NOT here) ──────
# Shared server credentials. These are NOT VITE_-prefixed and must never be
# exposed in the client bundle.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=xxx            # service_role key — keep secret

# Stripe webhook — existing web subscriptions and lifecycle updates.
# Exact price IDs are optional hardening; existing products continue to map by
# the exact product names "Fighter Pro" and "Coach Pro".
# STRIPE_SECRET_KEY=sk_live_xxx            # or sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx          # Stripe webhook signing secret
# STRIPE_FIGHTER_PRICE_IDS=                 # optional, comma-separated
# STRIPE_COACH_PRICE_IDS=                   # optional, comma-separated

# AI Coach — server-provided analysis included with Pro.
# ANTHROPIC_API_KEY=sk-ant-xxx             # the app's own key — never client-side
# AI_MODEL=claude-haiku-4-5                # default; use an available model id
# AI_QUOTA_PRO=40                          # included analyses per month (Pro)
# AI_QUOTA_FREE=3                          # free-tier taster analyses per month
# COMP_PRO_EMAILS=                         # server-side comp allowlist (comma-separated)

# RevenueCat webhook — server-verified App Store entitlements. Must equal the
# Authorization header value configured in RevenueCat.
# REVENUECAT_WEBHOOK_SECRET=
